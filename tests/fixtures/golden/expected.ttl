@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix r9-parts: <https://w3id.org/r9lab/vocabulary/parts/> .
@prefix r9-tools: <https://w3id.org/r9lab/vocabulary/tools/> .
@prefix r9lab: <https://w3id.org/r9lab/vocabulary/terms#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/r9lab/vocabulary/> a dcat:Dataset,
        schema:DefinedTermSet ;
    dcterms:created "2026-01-01"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-1825-0097> ;
    dcterms:hasPart r9-parts:,
        r9-tools: ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-02-01"^^xsd:date ;
    dcterms:publisher <https://orcid.org/0000-0002-1825-0097> ;
    dcterms:title "R9lab reference vocabulary"@en ;
    owl:versionIRI <https://w3id.org/r9lab/vocabulary/1.0.0/> ;
    owl:versionInfo "1.0.0" ;
    dcat:landingPage <https://example.org/r9lab-vocabulary> ;
    schema:name "R9lab reference vocabulary"@en .

r9-parts:collection a skos:Collection ;
    skos:member r9-parts:p01,
        r9-parts:p02 ;
    skos:prefLabel "Fasteners a pilot counts"@en .

r9lab:UNUKEYv1 a rdfs:Datatype ;
    rdfs:label "UNU-KEY v1 code"@en ;
    rdfs:seeAlso <https://doi.org/10.5281/zenodo.18328494> .

r9lab:UNUKEYv2 a rdfs:Datatype ;
    rdfs:label "UNU-KEY v2 code"@en ;
    rdfs:seeAlso <https://doi.org/10.5281/zenodo.18328494> .

r9lab:unuKey a owl:DatatypeProperty ;
    rdfs:label "UNU-KEY"@en ;
    rdfs:comment "The UNU-KEY the product type falls under, from the E-waste Statistics Guidelines. The datatype names the key version. Only the code is given: the key names are under a non-commercial licence."@en .

r9-tools:t03 a skos:Concept,
        schema:DefinedTerm ;
    dcterms:isReplacedBy r9-tools:t02 ;
    bibo:status <http://purl.org/ontology/bibo/status/accepted> ;
    owl:deprecated true ;
    skos:inScheme r9-tools: ;
    skos:prefLabel "old screwdriver"@en .

r9-tools:t01 a skos:Concept,
        schema:DefinedTerm ;
    bibo:status <http://purl.org/ontology/bibo/status/accepted> ;
    skos:definition "A tool worked by hand."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1> ;
    skos:example "a hammer"@en ;
    skos:inScheme r9-tools: ;
    skos:narrower r9-tools:t02 ;
    skos:prefLabel "hand tool"@en ;
    skos:scopeNote "Not power tool: a hand tool has no motor."@en ;
    skos:topConceptOf r9-tools: ;
    r9lab:unuKey "0001"^^r9lab:UNUKEYv1 .

r9-tools:t02 a skos:Concept,
        schema:DefinedTerm ;
    bibo:status <http://purl.org/ontology/bibo/status/accepted> ;
    skos:broader r9-tools:t01 ;
    skos:closeMatch r9-parts:p01 ;
    skos:definition "Hand tool that turns screws."@en ;
    skos:example "a flat-blade screwdriver"@en ;
    skos:inScheme r9-tools: ;
    skos:notation "driver" ;
    skos:prefLabel "screwdriver"@en ;
    skos:scopeNote "Not hand tool in general: it only turns screws."@en .

r9-parts:p01 a skos:Concept,
        schema:DefinedTerm ;
    bibo:status <http://purl.org/ontology/bibo/status/accepted> ;
    skos:definition "Threaded fastener turned into a hole or a nut."@en ;
    skos:example "a wood screw"@en ;
    skos:inScheme r9-parts: ;
    skos:prefLabel "screw"@en ;
    skos:related r9-parts:p02 ;
    skos:scopeNote "Any threaded fastener."@en ;
    skos:topConceptOf r9-parts: .

r9-parts:p02 a skos:Concept,
        schema:DefinedTerm ;
    bibo:status <http://purl.org/ontology/bibo/status/accepted> ;
    skos:definition "Block with a threaded hole that a screw or bolt turns into."@en ;
    skos:example "a hex nut"@en ;
    skos:inScheme r9-parts: ;
    skos:prefLabel "nut"@en ;
    skos:scopeNote "Not screw: a nut has no shaft."@en ;
    skos:topConceptOf r9-parts: .

r9-parts: a skos:ConceptScheme,
        schema:DefinedTermSet ;
    dcterms:created "2026-01-02"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-1825-0097> ;
    dcterms:description "Fasteners, to pin what the build writes."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-02-01"^^xsd:date ;
    dcterms:publisher <https://orcid.org/0000-0002-1825-0097> ;
    dcterms:title "Fasteners"@en ;
    bibo:status <http://purl.org/ontology/bibo/status/accepted> ;
    owl:versionIRI <https://w3id.org/r9lab/vocabulary/1.0.0/parts/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "Fasteners, to pin what the build writes."@en ;
    skos:hasTopConcept r9-parts:p01,
        r9-parts:p02 ;
    skos:prefLabel "Fasteners"@en ;
    dcat:landingPage <https://example.org/r9lab-vocabulary> ;
    schema:name "Fasteners"@en .

r9-tools: a skos:ConceptScheme,
        schema:DefinedTermSet ;
    dcterms:created "2026-01-01"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-1825-0097> ;
    dcterms:description "Hand tools, to pin what the build writes."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-02-01"^^xsd:date ;
    dcterms:publisher <https://orcid.org/0000-0002-1825-0097> ;
    dcterms:title "Workshop tools"@en ;
    bibo:status <http://purl.org/ontology/bibo/status/accepted> ;
    owl:versionIRI <https://w3id.org/r9lab/vocabulary/1.0.0/tools/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "Hand tools, to pin what the build writes."@en ;
    skos:hasTopConcept r9-tools:t01 ;
    skos:prefLabel "Workshop tools"@en ;
    dcat:landingPage <https://example.org/r9lab-vocabulary> ;
    schema:name "Workshop tools"@en .

