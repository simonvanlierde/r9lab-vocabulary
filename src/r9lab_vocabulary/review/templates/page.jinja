<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tag mapping review</title>
<link rel="stylesheet" href="/static/review.css">
<script src="/static/htmx.min.js"></script>
<script src="/static/hx-sse.min.js"></script>
<script src="/static/review.js" defer></script>
</head>
<body>
<header>
  <div hx-sse:connect="/progress" hx-swap="innerHTML">{% include "progress.jinja" %}</div>
  <button type="button" id="pause" aria-pressed="false" aria-keyshortcuts="p" hidden>Pause</button>
  <p class="help">Reviewing as {{ s.reviewer }}, by the
    <a href="https://github.com/simonvanlierde/r9lab-vocabulary/blob/main/docs/review-protocol.md" target="_blank" rel="noopener">review protocol</a>.
    Keys: <kbd>a</kbd> agree, <kbd>u</kbd> unsure, <kbd>d</kbd> disagree, <kbd>z</kbd> undo, <kbd>p</kbd> pause.</p>
</header>
<p id="paused" role="status" hidden>Paused. The clock is stopped and the card is hidden; press <kbd>p</kbd> or Resume to go on.</p>
<main>{% include "card.jinja" %}</main>
</body>
</html>
